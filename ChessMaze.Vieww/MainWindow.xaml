 <Window x:Class="ChessMaze.Vieww.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chess Maze"
        Height="720"
        Width="950"
        MinHeight="650"
        MinWidth="850"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Chessboard square button style -->
        <Style x:Key="SquareButtonStyle"
               TargetType="Button">

            <Setter Property="Background" Value="#F0D9B5"/>
            <Setter Property="BorderBrush" Value="#8B7355"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                    <Setter Property="Background" Value="#A8D5A2"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsStart}" Value="True">
                    <Setter Property="Background" Value="#F4D58D"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsCurrentPosition}" Value="True">
                    <Setter Property="Background" Value="#FFD54F"/>
                    <Setter Property="BorderBrush" Value="#D97706"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <!-- Chessboard square template -->
        <DataTemplate x:Key="SquareTemplate">

            <Button Style="{StaticResource SquareButtonStyle}"
                    Command="{Binding DataContext.SelectSquareCommand,
                        RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding Position}">

                <Grid>

                    <!-- Chess piece image -->
                    <Image Source="{Binding PieceImage}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="48"
                           MaxHeight="48"/>

                    <!-- Start marker -->
                    <TextBlock Text="S"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#7C2D12"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStart}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                    <!-- Target marker -->
                    <TextBlock Text="★"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#166534"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

            </Button>

        </DataTemplate>

    </Window.Resources>

    <!-- Main window -->
    <Grid Margin="20">

        <!-- START SCREEN -->
        <Grid Visibility="{Binding StartScreenVisibility}">

            <StackPanel Width="320"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="Chess Maze"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Welcome to Chess Maze!"
                           FontSize="17"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Enter your game name:"
                           FontSize="16"
                           Margin="0,0,0,8"/>

                <TextBox Text="{Binding CurrentGameName,
                                        UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16"
                         Padding="8"
                         Margin="0,0,0,20"/>

                <Button Content="Start Game"
                        Command="{Binding StartGameCommand}"
                        FontSize="16"
                        FontWeight="Bold"
                        Padding="10"
                        IsDefault="True"/>

            </StackPanel>

        </Grid>

        <!-- GAME SCREEN -->
        <Grid Visibility="{Binding GameScreenVisibility}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Game title and player name -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,20">

                <TextBlock Text="Chess Maze"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="  |  Player: "
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>

                <TextBlock Text="{Binding CurrentGameName}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </StackPanel>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Board and restart -->
                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                    <TextBlock Text="Select a destination square to request a move."
                               FontSize="14"
                               Foreground="Gray"
                               Margin="0,0,0,15"/>

                    <Border Height="2"
                            Background="#444444"
                            Margin="0,0,0,10"/>

                    <Border BorderBrush="#444444"
                            BorderThickness="2"
                            Padding="2"
                            Width="450"
                            Height="450"
                            HorizontalAlignment="Left">

                        <ItemsControl ItemsSource="{Binding Squares}"
                                      ItemTemplate="{StaticResource SquareTemplate}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="6" Columns="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                        </ItemsControl>

                    </Border>

                    <Button Content="Restart"
                            Command="{Binding RestartCommand}"
                            Width="150"
                            Height="38"
                            FontSize="15"
                            FontWeight="Bold"
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- Move history -->
                <StackPanel Grid.Column="1">

                    <TextBlock Text="Move History"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <ListBox ItemsSource="{Binding MoveHistory}"
                             FontSize="14"
                             Height="450"
                             Padding="8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>